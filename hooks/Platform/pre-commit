#!/bin/bash
set -euo pipefail

current_branch=$(git branch --show-current)
if [[ $current_branch == local_* || $current_branch == "" ]]; then
  echo "提交本地分支: $current_branch"
  exit 0
fi

white_list=("README.md" "hooks/pre-commit" "hooks/pre-push" ".gitignore" "config.bat" "config.sh")

is_in_white_list() {
  for item in "${white_list[@]}"; do
    if [[ "$item" == "$1" ]]; then
      return 0
    fi
  done
  return 1
}

require_var() {
  if [[ -z "${!1:-}" ]]; then
    echo "$1 is required for service-owned reverse sync"
    exit 1
  fi
}

require_var SVN2GIT_SERVICE_URL
SVN2GIT_REPO_NAME=${SVN2GIT_REPO_NAME:-Platform}

staged_files=$(git diff --cached --name-only --diff-filter=ACMR)
deleted_files=$(git diff --cached --name-only --diff-filter=D)

if [[ -z "$staged_files" && -z "$deleted_files" ]]; then
  echo "没有新增、修改或删除的文件"
  exit 1
fi

filtered_paths=""
for file in $staged_files $deleted_files; do
  if is_in_white_list "$file"; then
    echo "不提交 $file"
    continue
  fi
  filtered_paths+="$file"$'\n'
done

if [[ -z "$filtered_paths" ]]; then
  exit 0
fi

commit_msg_path=$(eval echo ~"${SUDO_USER:-$USER}")/AppData/Local/Temp/git-commit-msg-.txt
commit_msg=$(git log -1 --pretty=%B 2>/dev/null || true)
if [[ -f "$commit_msg_path" ]]; then
  commit_msg=$(cat "$commit_msg_path")
fi
commit_sha=$(git rev-parse HEAD 2>/dev/null || echo "uncommitted")

payload=$(printf 'branch: %s\ncommit: %s\nmessage: %s\npaths:\n%s' "$current_branch" "$commit_sha" "$commit_msg" "$filtered_paths")
curl -fsS -X POST --data-binary "$payload" "$SVN2GIT_SERVICE_URL/reverse-sync/$SVN2GIT_REPO_NAME"

echo "Git 提交已被拒绝。更改已提交给 service-owned reverse sync。请等待服务同步后更新代码检查结果。"
exit 1
